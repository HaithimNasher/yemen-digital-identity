  "notice_ar": "هذا نموذج معماري وسياساتي للمشروع وليس إعلانًا عن سجل وطني تشغيلي أو جهة تسجيل رسمية.",
  "principles": [
    "Separate registry operator functions from registrar customer-facing functions",
    "Use explicit role-based access control",
    "Treat namespace policy as separate from live registry state",
    "Maintain complete auditability for every domain lifecycle transition",
    "Support RDAP-first public registration data architecture",
    "Design DNSSEC and secure provisioning as first-class capabilities",
    "Do not infer domain ownership from screenshots or static directory data"
  ],
