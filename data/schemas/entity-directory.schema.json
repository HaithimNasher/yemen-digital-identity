{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ydii.example/schema/entity-directory.schema.json",
  "title": "YDII National Directory Entity",
  "type": "object",
  "required": [
    "id",
    "name_ar",
    "name_en",
    "verification_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name_ar": {"type": "string", "minLength": 2},
    "name_en": {"type": "string", "minLength": 2},
    "governorate": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "current_domain": {"type": ["string", "null"]},
    "suggested_ye_domain": {"type": ["string", "null"]},
    "domain_status": {
      "type": ["string", "null"],
      "enum": ["CURRENT", "VERIFIED", "PROPOSED", "UNKNOWN", null]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified-source",
        "user-provided",
        "screenshot-reference",
        "pending-verification"
      ]
    },
    "source_url": {
      "type": ["string", "null"],
      "pattern": "^https://"
    },
    "source_note": {"type": ["string", "null"]},
    "last_verified": {
      "type": ["string", "null"],
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "additionalProperties": true
}
